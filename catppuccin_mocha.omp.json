{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue": "#89B4FA",
    "lavender": "#B4BEFE",
    "pink": "#F5C2E7",
    "green": "#A6E3A1",
    "yellow": "#F9E2AF",
    "red": "#F38BA8",
    "os": "#ACB0BE",
    "subtext": "#A6ADC8",
    "closer": "p:lavender"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:os",
          "template": "{{.Icon}} "
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:green",
          "properties": { "display_version": false, "fetch_version": false },
          "template": "\ue235 "
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "p:blue",
          "template": "{{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:pink",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "home_icon": "~",
            "folder_icon": "\ue5fe"
          },
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:yellow",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:red{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:lavender{{ end }}",
            "{{ if gt .Ahead 0 }}p:green{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": "\ue725 "
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:subtext",
          "properties": {
            "threshold": 2000,
            "style": "round"
          },
          "template": "\uf252 {{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "p:subtext",
          "properties": { "time_format": "15:04:05" },
          "template": "\uf017 {{ .CurrentDate | date .Format }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "properties": { "always_enabled": true },
          "template": "{{ if gt .Code 0 }}\uf00d{{ else }}\uf105{{ end }} "
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
